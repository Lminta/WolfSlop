<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedPlatform>browser</SupportedPlatform>
    <Description>Blazor WebAssembly provider for WolfSlop.Engine: WebGPU, Canvas UI, browser input, frame scheduling and Web Audio.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WolfSlop.Engine/WolfSlop.Engine.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="SpawnDev.BlazorJS" Version="3.5.30" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
