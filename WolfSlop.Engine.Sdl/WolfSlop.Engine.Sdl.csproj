<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="3.2.1" />
    <ProjectReference Include="../WolfSlop.Engine/WolfSlop.Engine.csproj" />
    <PackageReference Include="SDL3-CS" Version="3.4.18.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <EmbeddedResource Include="Shaders/Compiled/*" />
    <EmbeddedResource Include="Fonts/*.ttf" />
    <Content Include="Fonts/*-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
